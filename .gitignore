/svd_data*/
*.nsp
*.egg
*.wav
*.db
*.db-journal
*.sqlite
*.sqlite3

# Derived features and trained model binaries.
/embeddings/
/milestone2/features/
/milestone2/feedback_holdout_inputs/features/
*.npy
*.npz
*.pkl
*.pickle
*.pt
*.pth
*.safetensors
/milestone2/reference_sources/FeatureStates_SVD.csv

# Session-level labels, demographic records, predictions and local file paths.
# Aggregate metrics, fold counts, protocol JSON and figures remain publishable.
/splits.csv
/embedding_coverage.csv
/embedding_times.csv
/milestone2/coverage.csv
/milestone2/feedback_holdout_inputs/coverage.csv
/milestone2/feedback_holdout_inputs/feature_times.csv
**/oof.csv
**/oof_predictions.csv
**/predictions.csv
**/test_predictions.csv
**/matched_predictions.csv
**/excluded_sessions.csv
**/missing_embeddings.csv

